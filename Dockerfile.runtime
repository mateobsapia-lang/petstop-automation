# Builder conserva las herramientas de compilación fuera de la imagen final.
FROM python:3.12-slim-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY requirements-lock.txt ./
RUN pip install --prefix=/install --no-cache-dir -r requirements-lock.txt

# Runtime recibe paquetes y código, con un usuario sin privilegios.
FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 app
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=app:app . .
RUN mkdir -p data && chown app:app data
USER app
EXPOSE 8501
CMD ["streamlit", "run", "dashboard.py", "--server.address=0.0.0.0", "--server.port=8501"]
